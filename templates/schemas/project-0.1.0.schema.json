{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcps.dev/schemas/project-0.1.0.schema.json",
  "title": "VCPS project configuration (schema_version 0.1.0, supported predecessor)",
  "description": "Structural schema for a project.yaml at the supported predecessor schema 0.1.0, per templates/contract.md's migration rule: 'Migration to 0.2.0 adds installation.plan: null, plan_history: [], and stage_events: []' -- implying 0.1.0's installation object has none of those three fields. This schema exists only to read/validate a pre-migration config before its one defined migration path to project.schema.json (0.2.0) is applied; it is not a parallel ongoing format. NEW_CANONICAL_RECONSTRUCTION authored 2026-10-06; see evaluation/completion-roadmap.md Phase B.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_layout_version", "vcps_version", "project",
    "level", "installation", "repository", "stack", "commands", "ci",
    "critical_domains", "applicable_invariants", "evidence_policy",
    "baseline_ref", "config_history", "lifecycle"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "artifact_layout_version": { "const": "0.1.0" },
    "vcps_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rationale", "evidence_refs"],
      "properties": {
        "value": { "enum": ["L1", "L2", "L3"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "lowering_approval_ref": { "type": ["string", "null"] }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "level": { "enum": ["L1", "L2", "L3"] }
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "route", "stage", "status", "history", "pending_artifact_refs"],
      "description": "No plan/plan_history/stage_events at schema 0.1.0 -- these are the exact fields the 0.1.0 -> 0.2.0 migration adds.",
      "properties": {
        "mode": { "type": ["string", "null"], "enum": ["NEW", "ADOPT", "UPGRADE", "REPAIR", null] },
        "route": { "enum": ["MODE_SELECTION", "RESUME", "ALREADY_COMPLETE"] },
        "stage": { "type": ["integer", "null"], "minimum": 1, "maximum": 11 },
        "status": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timestamp", "reason"],
            "properties": {
              "timestamp": { "type": "string", "format": "date-time" },
              "from_status": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
              "to_status": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
              "from_stage": { "type": ["integer", "null"] },
              "to_stage": { "type": ["integer", "null"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "pending_artifact_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcs"],
      "properties": {
        "vcs": { "enum": ["git", "NONE"] },
        "remote": { "type": ["string", "null"] },
        "default_branch": { "type": ["string", "null"] }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "package_managers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "working_directory", "command"],
        "properties": {
          "id": { "type": "string" },
          "purpose": { "type": "string" },
          "working_directory": { "type": "string" },
          "command": { "type": "string" }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean" },
        "provider": { "type": ["string", "null"] },
        "config_paths": { "type": "array", "items": { "type": "string" } },
        "job_gate_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["job", "gates"],
            "properties": {
              "job": { "type": "string" },
              "gates": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 6 } }
            }
          }
        }
      }
    },
    "critical_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "rationale"],
        "properties": {
          "domain": { "type": "string" },
          "rationale": { "type": "string" },
          "impact_dimensions": {
            "type": "array",
            "items": { "enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9"] }
          }
        }
      }
    },
    "applicable_invariants": {
      "type": "array",
      "items": { "type": "string", "pattern": "^INV-[0-9]{3,}$" }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_tier_overrides": {
          "type": "object",
          "additionalProperties": { "enum": ["E1", "E2", "E3", "E4", "E5"] }
        }
      }
    },
    "baseline_ref": {
      "type": ["string", "null"],
      "enum": [".vcps/baseline.md", null]
    },
    "config_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "event", "reason"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "event": { "type": "string" },
          "from": {},
          "to": {},
          "reason": { "type": "string" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_observation_window_days"],
      "properties": {
        "default_observation_window_days": { "type": ["integer", "null"] },
        "notes": { "type": "string" }
      }
    },
    "project_local_policy_refs": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
