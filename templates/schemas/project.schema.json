{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vcps.dev/schemas/project.schema.json",
  "title": "VCPS project configuration (schema_version 0.2.0)",
  "description": "Structural schema for .vcps/project.yaml. Required top-level keys per templates/contract.md and adapters/claude-code/vcps-setup/scripts/vcps_tool.py's validate() (kept in lockstep: both name the same 16 required fields). Owned in content across standard/VCPS.md VCPS-CORE-030, standard/risk-model.md, standard/artifacts.md, and workflows/setup.md's Deterministic Setup Engine contract (installation object). NEW_CANONICAL_RECONSTRUCTION authored 2026-10-06; see evaluation/completion-roadmap.md Phase B.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_layout_version", "vcps_version", "project",
    "level", "installation", "repository", "stack", "commands", "ci",
    "critical_domains", "applicable_invariants", "evidence_policy",
    "baseline_ref", "config_history", "lifecycle"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "artifact_layout_version": { "const": "0.1.0" },
    "vcps_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rationale", "evidence_refs"],
      "properties": {
        "value": {
          "enum": ["L1", "L2", "L3"],
          "description": "MUST equal risk-model.md's derived level for the PROJECT-scope profile (templates/contract.md: 'Level is owned only by project.yaml and must match Core's derivation')."
        },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EVD-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "lowering_approval_ref": {
          "type": ["string", "null"],
          "pattern": "^HCR-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "Required (non-null) when this level is lower than a previously recorded level (VCPS-RISK-022, HC-09)."
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "level": { "enum": ["L1", "L2", "L3"] }
        }
      }
    },
    "installation": { "$ref": "#/$defs/installation" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcs"],
      "properties": {
        "vcs": { "enum": ["git", "NONE"] },
        "remote": {
          "type": ["string", "null"],
          "description": "Credential-free remote URL only (templates/validation.md item 2: reject credentialed URLs)."
        },
        "default_branch": { "type": ["string", "null"] }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": { "type": "array", "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "package_managers": { "type": "array", "items": { "type": "string" } }
      },
      "description": "Empty discovered lists are valid (templates/contract.md); never invent commands or frameworks not actually observed."
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "working_directory", "command"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "working_directory": {
            "type": "string",
            "description": "Repository-relative, per templates/validation.md item 4."
          },
          "command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean" },
        "provider": { "type": ["string", "null"] },
        "config_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Repository-relative CI config paths (templates/validation.md item 4)."
        },
        "job_gate_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["job", "gates"],
            "properties": {
              "job": { "type": "string" },
              "gates": {
                "type": "array",
                "items": { "type": "integer", "minimum": 1, "maximum": 6 }
              }
            }
          },
          "description": "Stage 10 (VCPS-SETUP-025): which CI job provides which gate's E3 evidence."
        }
      }
    },
    "critical_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "rationale"],
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "The traced impact path, not a keyword match (VCPS-RISK-002)."
          },
          "impact_dimensions": {
            "type": "array",
            "items": { "enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7", "D8", "D9"] }
          }
        }
      }
    },
    "applicable_invariants": {
      "type": "array",
      "items": { "type": "string", "pattern": "^INV-[0-9]{3,}$" },
      "description": "Every ID here MUST exist in invariants.md (templates/validation.md item 4). Removing one requires a recorded risk decision and HC-08."
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_tier_overrides": {
          "type": "object",
          "additionalProperties": { "enum": ["E1", "E2", "E3", "E4", "E5"] },
          "description": "MAY only strengthen a Core minimum from levels.md SS2, never lower it (templates/contract.md)."
        }
      }
    },
    "baseline_ref": {
      "type": ["string", "null"],
      "enum": [".vcps/baseline.md", null],
      "description": ".vcps/baseline.md, or null only before Stage 8 (templates/contract.md)."
    },
    "config_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "event", "reason"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "event": { "type": "string", "minLength": 1 },
          "from": {},
          "to": {},
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_observation_window_days"],
      "properties": {
        "default_observation_window_days": {
          "type": ["integer", "null"],
          "description": "DESIGN DECISION (not recovered, not elsewhere specified by surviving Core text -- standard/open-questions.md OQ-008 leaves a default window explicitly open): this project-level default is informational only and is never a feature's authoritative observation_window, which lifecycle.md/work-item.schema.json own per-feature. Null means no project-level default is set."
        },
        "notes": { "type": "string" }
      }
    },
    "project_local_policy_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "route", "stage", "status", "plan", "plan_history", "stage_events", "history", "pending_artifact_refs"],
      "properties": {
        "mode": {
          "type": ["string", "null"],
          "enum": ["NEW", "ADOPT", "UPGRADE", "REPAIR", null],
          "description": "Populated only when route is MODE_SELECTION (VCPS-SETUP-003/VCPS-SETUP-001). Resume/already-complete are routes, never a fifth mode."
        },
        "route": {
          "enum": ["MODE_SELECTION", "RESUME", "ALREADY_COMPLETE"]
        },
        "stage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 11,
          "description": "Earliest outstanding stage (VCPS-SETUP-055); null only when all eleven are complete."
        },
        "status": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
        "plan": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/plan" }],
          "description": "Null only during 0.1.0 migration before Stage 4 (templates/contract.md); active setup at Stage 4+ requires a plan."
        },
        "plan_history": {
          "type": "array",
          "items": { "$ref": "#/$defs/plan" },
          "description": "Append-only; never includes the currently active plan (templates/validation.md item 13)."
        },
        "stage_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/stage_event" },
          "description": "Append-only attempt/invalidation journal (VCPS-SETUP-053)."
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timestamp", "reason"],
            "properties": {
              "timestamp": { "type": "string", "format": "date-time" },
              "from_status": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
              "to_status": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
              "from_stage": { "type": ["integer", "null"] },
              "to_stage": { "type": ["integer", "null"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "pending_artifact_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Canonical files a setup stage has not created yet. Empty required for COMPLETE (templates/contract.md)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "COMPLETE" } }, "required": ["status"] },
          "then": {
            "properties": {
              "pending_artifact_refs": { "maxItems": 0 },
              "stage": { "const": null }
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_revision", "mode", "level", "create_paths", "modify_paths",
        "intended_checks", "likely_checkpoints", "allowed_paths",
        "allowed_operations", "max_changed_files", "max_bytes",
        "max_commands", "sha256"
      ],
      "properties": {
        "base_revision": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["NEW", "ADOPT", "UPGRADE", "REPAIR"] },
        "level": { "enum": ["L1", "L2", "L3", null] },
        "create_paths": { "type": "array", "items": { "type": "string" } },
        "modify_paths": { "type": "array", "items": { "type": "string" } },
        "intended_checks": { "type": "array", "items": { "type": "string" } },
        "likely_checkpoints": {
          "type": "array",
          "items": { "pattern": "^HC-(0[1-9]|1[0-6])$" }
        },
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "allowed_operations": {
          "type": "array",
          "items": { "enum": ["create", "modify"] },
          "description": "VCPS-SETUP-052: no deletion, move, history rewrite, or production operation is in a routine setup budget."
        },
        "max_changed_files": { "type": "integer", "minimum": 0 },
        "max_bytes": { "type": "integer", "minimum": 0 },
        "max_commands": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of UTF-8 canonical JSON of this object excluding sha256 itself (VCPS-SETUP-052)."
        }
      }
    },
    "stage_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage", "event_state", "timestamp", "input_revision",
        "input_scope", "input_fingerprint", "plan_hash"
      ],
      "properties": {
        "stage": { "type": "integer", "minimum": 1, "maximum": 11 },
        "event_state": { "enum": ["COMPLETED", "PARTIAL", "BLOCKED", "INVALIDATED"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "input_revision": { "type": "string" },
        "input_scope": { "type": "array", "items": { "type": "string" } },
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "templates/validation.md item 14: SHA-256 of canonical JSON over expanded input_scope paths, excluding installation.plan/plan_history/stage_events/history/stage/status and never following symlinks through their content."
        },
        "output_revision": { "type": ["string", "null"] },
        "plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "finding_refs": { "type": "array", "items": { "type": "string" } },
        "approval_refs": { "type": "array", "items": { "type": "string" } },
        "pending_checkpoints": {
          "type": "array",
          "items": { "pattern": "^HC-(0[1-9]|1[0-6])$" }
        },
        "mutation_paths": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "event_state": { "const": "BLOCKED" } }, "required": ["event_state"] },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
